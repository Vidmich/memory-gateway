# Memory Gateway — environment configuration.
#
# Copy to `.env` for local runs outside Compose. Every variable without a default is
# required: the process refuses to start without it, naming what is missing.
# Values below are dev-safe and match deploy/compose/docker-compose.yml.

# --- service ---------------------------------------------------------------
# dev | test | staging | prod. Anything but `prod` exposes /docs.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- postgres (required) ---------------------------------------------------
# Must use the asyncpg driver; the app is async end to end.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- redis (required) ------------------------------------------------------
# Queue (task 09), rate-limit buckets (task 14), gateway-config cache (task 06).
REDIS_URL=redis://localhost:6379/0

# --- qdrant (required) -----------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- object storage (required) ---------------------------------------------
# MinIO locally, S3 in production. Path-style addressing is used for both.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memory-gateway
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# --- secrets (required) ----------------------------------------------------
# Wraps the per-record data keys that encrypt provider credentials. Must be
# base64 of exactly 32 bytes. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Rotating this key is a documented procedure (task 18) — it re-wraps data keys.
ENCRYPTION_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
# Signs control-plane access tokens. At least 32 characters. Rotating it signs every
# user out at their next request, which is a safe (if noisy) thing to do.
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-please

# --- control-plane auth ----------------------------------------------------
# Argon2id cost. Raise PASSWORD_MEMORY_COST_KIB first: memory hardness is what costs an
# attacker with GPUs. Existing hashes carry their own parameters and are re-hashed on
# each user's next login, so raising these needs no migration.
PASSWORD_TIME_COST=3
PASSWORD_MEMORY_COST_KIB=65536
PASSWORD_PARALLELISM=1

# Access tokens are short-lived because they cannot be revoked before they expire;
# refresh tokens are rotated on every use and live in an httpOnly cookie.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Used when the user does not tick "keep me signed in".
REFRESH_TOKEN_SHORT_TTL_SECONDS=43200

# Failed logins allowed per window, counted per IP *and* per email.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- probe buttons ---------------------------------------------------------
# Presses allowed per user per window, shared by "Test connection" on a model and "Test
# gateway" on an endpoint. Each is an outbound call to a provider, billed to whoever owns
# the model — but getting a base URL right takes a few tries, so the ceiling is generous
# rather than tight.
MODEL_TEST_MAX_ATTEMPTS=20
MODEL_TEST_WINDOW_SECONDS=60

# --- audit log (SPEC 10.4) -------------------------------------------------
# CSV exports allowed per user per window. An export is the cheapest way to pull an
# organization's whole configuration history in one request, and each one is a streamed
# scan of the table — so it has a ceiling, sized for a person pressing a button rather
# than for a script in a loop.
AUDIT_EXPORT_MAX_ATTEMPTS=10
AUDIT_EXPORT_WINDOW_SECONDS=3600

# --- addressing (required) -------------------------------------------------
# How clients reach this service; used to build gateway URLs shown in the UI.
PUBLIC_BASE_URL=http://localhost:8000

# --- web UI ----------------------------------------------------------------
# Where the built SPA lives. Empty in development, where Vite serves it on :5173 and
# proxies /api here. In the production image this is /srv/web, and the API serves the
# assets itself — which keeps the UI same-origin with the API, so the refresh cookie
# needs no SameSite=None and there is no CORS preflight on the login path.
# WEB_DIST_DIR=/srv/web
#
# Only needed for a split-origin deployment. Leave empty when the API serves the UI.
# CORS_ORIGINS=["http://localhost:5173"]
#
# Where the UI lives, for links a person clicks — today, invitation links. Defaults to
# PUBLIC_BASE_URL, which is right in production because the API serves the SPA. In
# development the Vite server is on another port, so set it or invitees land on the API.
# APP_BASE_URL=http://localhost:5173

# --- probes ----------------------------------------------------------------
READINESS_TIMEOUT_SECONDS=2.0

# --- upstream calls --------------------------------------------------------
# Size of the shared connection pool used for provider calls. Per-request timeouts
# come from each upstream model's `timeout_seconds`, not from here.
UPSTREAM_MAX_CONNECTIONS=200
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=50

# Ceiling on a whole failover chain, in seconds. Each attempt still carries its own
# model's `timeout_seconds`; this is what stops three targets at 60 s each from becoming
# a three-minute request. Larger than the default model timeout, so a single-target
# gateway is unaffected by it.
ROUTING_DEADLINE_SECONDS=120

# --- rate limiting (SPEC 11) -----------------------------------------------
# What happens to a request when the limiter cannot reach Redis. `true` serves it and
# increments `rate_limit_unavailable_total`; `false` refuses it with a 503.
#
# The default is the less bad of two bad options and it is still a real trade: rate
# limiting is protective, not correctness-critical, and making it a hard dependency turns
# a Redis blip into an outage of every gateway at once. What it costs while it is open is
# that the shared upstream key is unprotected — which is exactly what the ceilings below
# guard — so an operator who would rather shed load than risk spend sets this to `false`.
RATE_LIMIT_FAIL_OPEN=true

# Platform ceilings for a gateway that routes to a **global catalog** model — one on the
# operator's credential rather than the organization's. Unset throughout by default,
# because a platform that starts throttling existing traffic on upgrade is worse than one
# that has to be configured.
#
# Where a value is set it is a *maximum*, not a default: a gateway asking for more is
# lowered to it, a gateway asking for less keeps its own number, and an org_admin cannot
# raise their own limit past it. A gateway that has set no limit at all is the most
# exposed configuration there is, so it gets the ceiling too.
# GLOBAL_MODEL_REQUESTS_PER_MINUTE=600
# GLOBAL_MODEL_TOKENS_PER_MINUTE=200000
# GLOBAL_MODEL_REQUESTS_PER_DAY=100000
# GLOBAL_MODEL_CONCURRENT_REQUESTS=20

# --- ingestion (SPEC 9.1-9.3) ----------------------------------------------
# Per-file cap, enforced while the bytes are streaming rather than after they have
# been stored. 50 MB by default.
UPLOAD_MAX_FILE_BYTES=52428800

# Per-organization storage ceiling in bytes. Unset means unlimited, which is the
# default for the same reason the rate limits are: a quota nobody set should not
# become an outage.
# STORAGE_QUOTA_BYTES=10737418240

# Wall-clock cap on reading one file, so a pathological input cannot occupy a worker.
# For PDF and Office documents it is enforced by killing the subprocess reading them,
# which is the difference between bounding the job and bounding the CPU.
EXTRACTION_TIMEOUT_SECONDS=120

# Subprocesses reading PDFs and Office documents. Each holds a parser's worth of memory,
# so this is the knob that bounds a worker's footprint under load.
EXTRACTION_WORKERS=2

# Address space one of those subprocesses may occupy, in bytes. POSIX only — Windows has
# no such rlimit, and there the time cap above is the only bound. Unset removes it.
EXTRACTION_MEMORY_LIMIT_BYTES=1073741824

# How long a presigned upload URL lives, in seconds.
UPLOAD_URL_TTL_SECONDS=900

# --- embeddings (SPEC 9.4) -------------------------------------------------
# One model for the whole platform: a Qdrant collection's vectors must all come from
# the same one, and mixing them silently degrades retrieval.
#
# `hash` is a local, lexical, offline embedder. It needs no key and no network, which
# is what makes the ingestion demo runnable on a laptop — and it knows nothing about
# meaning, so the service refuses to start with it when ENVIRONMENT=prod.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-bow
EMBEDDING_DIMENSION=256

# For a real provider, point these at any OpenAI-compatible /embeddings endpoint.
# Changing the model or the dimension invalidates every stored vector; task 17 adds
# the reindex-and-swap flow that makes that safe.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
EMBEDDING_BATCH_SIZE=96
EMBEDDING_MAX_CONCURRENCY=4

# --- worker ----------------------------------------------------------------
# Retry policy for background jobs. Backoff is exponential with full jitter, so a
# provider outage does not produce a synchronised second wave.
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=2
JOB_BACKOFF_CAP_SECONDS=300

# Jobs one worker process runs at once. Ingestion is I/O-bound apart from extraction,
# which runs in a thread, so this is about provider concurrency rather than CPU.
WORKER_MAX_JOBS=8

# --- outbound request guard (task 18) --------------------------------------
# An organization user can point an upstream model at any URL, which makes this service
# an authenticated request forwarder with a position inside your network. A base_url of
# http://169.254.169.254/... turns "test connection" into a credential read.
#
#   auto  - block private, loopback and link-local addresses when ENVIRONMENT=prod,
#           allow them everywhere else. The default, and the only one that is right in
#           both places: a developer pointing a model at http://localhost:11434 is
#           running Ollama, and a customer doing it in production is reading the pod's
#           metadata service.
#   block - always refuse, whatever the environment.
#   allow - never refuse. Do not use this in production; the Helm chart refuses to
#           render it alongside ENVIRONMENT=prod.
#
# The guard applies only to URLs a *tenant* chose. The embedding endpoint, Qdrant and
# the object store are the operator's own, go through a separate connection pool, and
# are never checked — a private address there is the normal deployment.
UPSTREAM_PRIVATE_ADDRESSES=auto

# Exemptions, for a legitimate internal endpoint such as a self-hosted vLLM. JSON lists.
# Hostnames are matched exactly, lowercased; there is no wildcard, because a wildcard
# here is an allowlist somebody reads as narrower than it is.
# UPSTREAM_ALLOWED_HOSTS=["vllm.models.svc.cluster.local"]
# UPSTREAM_ALLOWED_CIDRS=["10.42.0.0/16"]

# --- hardening (task 18) ---------------------------------------------------
# Ceiling on a request body outside the upload path, which streams and has its own
# per-file cap. Generous for a chat completion: 1 MiB of JSON is on the order of a
# quarter of a million tokens, which no context window accepts.
MAX_REQUEST_BODY_BYTES=4194304

# Strict-Transport-Security max-age, sent only when ENVIRONMENT=prod. Sending it from a
# host reachable over plain HTTP pins every browser that saw it to a scheme the host
# does not serve, and the fix is on those machines rather than on this one.
HSTS_MAX_AGE_SECONDS=31536000

# How long to keep serving after SIGTERM before the server stops accepting. Readiness
# fails immediately either way; this is the window in which the load balancer notices.
# terminationGracePeriodSeconds must exceed this plus ROUTING_DEADLINE_SECONDS — the
# Helm chart refuses to render if it does not.
SHUTDOWN_DRAIN_SECONDS=10

# --- tracing (SPEC 10.5) ---------------------------------------------------
# OTLP/HTTP endpoint of a collector. Empty disables tracing entirely and leaves the
# OpenTelemetry no-op tracer in place, which is what the test suite runs against.
# OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_SERVICE_NAME=memory-gateway

# Head sampling ratio. Errors are *not* handled here — the decision is taken before
# anything has failed — but by the collector's tail sampler; see
# deploy/otel/collector.yaml.
OTEL_SAMPLE_RATIO=0.05

# --- seeding (optional) ----------------------------------------------------
# Read only by `make seed` / `python -m app.cli seed`, never by the service.
#
# `make seed` always creates a superadmin and prints its generated password once. The
# demo gateway is created as well when a provider key is available; the key below is
# encrypted with ENCRYPTION_MASTER_KEY before it is stored.
# SEED_ADMIN_EMAIL=admin@example.com
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
